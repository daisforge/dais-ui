# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
/out-tsc
packages/vite-project/*.tgz

# dependencies
node_modules

# storybook
packages/storybook/src/*.string.json

# Изолированные тестовые проекты.
# package.json у них теперь в git: изоляция обеспечивается тем, что они не входят
# в workspaces корневого package.json, а не отсутствием файла в репозитории.
# package-lock.json остаётся вне git — он пересоздаётся при каждой установке и
# завязан на integrity собранного на лету ui-kit-tgz.tgz.
packages/webpack-project-finalheader/package-lock.json
packages/vite-project/package-lock.json
packages/webpack-finportal-platform/package-lock.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

