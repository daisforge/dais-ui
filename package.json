{
  "name": "@dais-ui/source",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "inst": "rm -rf node_modules && npm cache clean --force && npm i --ignore-scripts --verbose",
    "ci": "rm -rf node_modules && npm cache clean --force && npm ci --ignore-scripts --verbose",
    "lint": "nx run-many --target=lint --debug --verbose",
    "fix:lint": "nx run-many --target=lint --fix --verbose",
    "typecheck": "nx run-many --target=typecheck --verbose",
    "test": "nx run-many --target=test --verbose",
    "build": "NODE_OPTIONS=\"--max_old_space_size=4096\" NODE_ENV=production NX_DAEMON=false nx run-many --target=build --parallel=1 --verbose",
    "postbuild": "npm run meta && node ./packages/mcp-server/dist/indexer/buildIndex.js && npm run storybook:build",
    "mcp:i": "npm install --prefix packages/mcp-server",
    "mcp:ci": "npm install --prefix packages/mcp-server",
    "mcp:build-index": "npm run meta && npm run build --prefix packages/mcp-server && node ./packages/mcp-server/dist/indexer/buildIndex.js",
    "mcp:vendor-atomic": "npm run build --prefix packages/mcp-server && node ./packages/mcp-server/dist/indexer/vendorAtomicData.js",
    "mcp:vendor-atomic:check": "npm run mcp:vendor-atomic -- --dry-run",
    "mcp:harvest-docs": "npm run build --prefix packages/mcp-server && node ./packages/mcp-server/dist/indexer/harvestAtomicDocs.js",
    "mcp:harvest-docs:check": "npm run mcp:harvest-docs -- --dry-run",
    "mcp:vendor-refresh": "npm run mcp:vendor-atomic && npm run mcp:harvest-docs",
    "mcp:export-docs": "npm run build --prefix packages/mcp-server && node ./packages/mcp-server/dist/indexer/exportAtomicDocs.js",
    "mcp:start": "node ./packages/mcp-server/dist/server.js",
    "mcp:inspect": "npm run mcp:build-index && npx @modelcontextprotocol/inspector node ./packages/mcp-server/dist/server.js",
    "mcp:validate-index": "npm run build --prefix packages/mcp-server && node ./packages/mcp-server/dist/validate/validateIndex.js",
    "update": "npm run ui-kit:update && npm install -d @salutejs/plasma-icons@x.x.0 @salutejs/plasma-typo@x.x.0 @salutejs/sdds-finai@x.x.0 @salutejs/sdds-themes@x.x.0 && npm run clean-after-update && npm run ui-kit:generate-tokens",
    "clean-after-update": "npm run ui-kit:delete-after-update && node ./scripts/clean--root--package-lock.js",
    "prestorybook": "npm run generate-storybook-docs-utils",
    "storybook": "nx storybook storybook",
    "storybook-docs": "nx storybook storybook dev --docs",
    "prestorybook:build": "npm run prestorybook",
    "storybook:build": "NODE_OPTIONS=\"--max_old_space_size=4096\" nx build-storybook storybook",
    "ui-kit:circular-check": "npx madge --circular --extensions ts,tsx --ts-config packages/ui-kit/tsconfig.json packages/ui-kit/src",
    "ui-kit:generate-tokens": "node ./generators/generate-ui-kit-tokens-named-exports.js",
    "ui-kit:update": "npm install --prefix ./packages/ui-kit -d @salutejs/plasma-icons@x.x.0 @salutejs/plasma-typo@x.x.0 @salutejs/sdds-finai@x.x.0 @salutejs/sdds-themes@x.x.0 && npm run ui-kit:delete-after-update",
    "ui-kit:delete-after-update": "node ./scripts/delete--ui-kit--node_modules--package-lock.js",
    "ui-kit:updateX": "npm install --prefix ./packages/ui-kit -d @salutejs/plasma-icons@x.x.0 @salutejs/plasma-typo@x.x.0 @salutejs/sdds-finai@x.x.x @salutejs/sdds-themes@x.x.0 && npm run ui-kit:delete-after-update",
    "updateX": "npm run ui-kit:updateX && npm run ui-kit:generate-tokens && npm install -d @salutejs/plasma-icons@x.x.0 @salutejs/plasma-typo@x.x.0 @salutejs/sdds-finai@x.x.x @salutejs/sdds-themes@x.x.0 && npm run clean-after-update",
    "i": "npm i --prefix ./packages/ui-kit -d ${npm_config_pack} && npm run ui-kit:delete-after-update && npm i -d ${npm_config_pack} && npm run clean-after-update",
    "generate-storybook-docs-utils": "node ./generators/storybook/generate-TableContract-schema.js && node ./generators/storybook/generate-storybook-types-as-string-json.js && node ./generators/storybook/generate-storybook-func-as-string-json.js",
    "meta": "node ./generators/meta-info/generate-meta.js",
    "meta:split": "node ./generators/meta-info/generate-meta.js --split",
    "meta:both": "node ./generators/meta-info/generate-meta.js --both",
    "webpack-project:install": "node scripts/test-project-install-deps.js --webpack-project-finalheader --verbose",
    "webpack-project:install-without-tgz": "npm i --prefix packages/webpack-project-finalheader --verbose",
    "webpack-project:dev": "npm run dev --prefix ./packages/webpack-project-finalheader --verbose",
    "webpack-project:build": "npm run build --prefix ./packages/webpack-project-finalheader --verbose",
    "webpack-project:preview": "npm run preview --prefix ./packages/webpack-project-finalheader --verbose",
    "webpack-project:ui-kit-build-check": "node scripts/test-project-ui-kit-build-check.js --webpack-project-finalheader --verbose",
    "webpack-project:clear-after": "node scripts/test-project-clear-after.js --webpack-project-finalheader --verbose",
    "finportal:install": "node scripts/test-project-install-deps.js --webpack-finportal-platform --verbose",
    "finportal:install-without-tgz": "npm i --prefix packages/webpack-finportal-platform --verbose",
    "finportal:dev": "npm run dev --prefix ./packages/webpack-finportal-platform --verbose",
    "finportal:build": "npm run build --prefix ./packages/webpack-finportal-platform --verbose",
    "finportal:ui-kit-build-check": "node scripts/test-project-ui-kit-build-check.js --webpack-finportal-platform --verbose",
    "finportal:clear-after": "node scripts/test-project-clear-after.js --webpack-finportal-platform --verbose",
    "vite-project:install": "node scripts/test-project-install-deps.js",
    "vite-project:install-without-tgz": "npm i --prefix ./packages/vite-project --verbose",
    "vite-project:dev": "npm run dev --prefix ./packages/vite-project --verbose",
    "vite-project:build": "npm run build --prefix ./packages/vite-project --verbose",
    "vite-project:preview": "npm run preview --prefix ./packages/vite-project --verbose",
    "vite-project:ui-kit-build-check": "node scripts/test-project-ui-kit-build-check.js",
    "vite-project:clear-after": "node scripts/test-project-clear-after.js --verbose",
    "prepare": "husky",
    "screenshot:test": "vitest run --config packages/storybook/vitest.screenshot.config.ts",
    "screenshot:test:one": "vitest run --config packages/storybook/vitest.screenshot.config.ts",
    "screenshot:clean": "npx rimraf packages/storybook/__snapshots__/*.png",
    "screenshot:update": "npm run screenshot:clean && vitest run --config packages/storybook/vitest.screenshot.config.ts -u",
    "screenshot:update:one": "vitest run --config packages/storybook/vitest.screenshot.config.ts -u",
    "mcp:search-eval": "node ./packages/mcp-server/ab/search-eval.mjs"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@swc/helpers": "^0.5.23",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash.clonedeep": "^4.5.8",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^22.20.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.4",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-is": "18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/styled-components": "5.1.26",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "babel-plugin-styled-components": "^1.10.7",
    "eslint": "^9.39.5",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^10.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lerna": "^10.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "nx": "23.2.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "storybook": "10.6.1",
    "ts-json-schema-generator": "^2.4.0-next.4",
    "ts-node": "10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@glideappsfinal/glide-data-grid": "6.5.1",
    "@hookform/resolvers": "3.10.0",
    "@salutejs-ds/sdds_finai_beta_core": "0.1.0",
    "@salutejs-ds/sdds_finai_high_contrast": "0.1.0",
    "@salutejs/plasma-icons": "^1.250.0",
    "@salutejs/plasma-typo": "^0.54.0",
    "@salutejs/sdds-finai": "^0.360.0",
    "@salutejs/sdds-themes": "^0.82.0",
    "@tanstack/react-virtual": "3.14.10",
    "canvas-hypertxt": "1.0.3",
    "lodash.clonedeep": "4.5.0",
    "lodash.isequal": "4.5.0",
    "react": "18.3.1",
    "react-data-grid": "7.0.0-beta.43",
    "react-dom": "18.3.1",
    "react-grid-layout": "1.5.4",
    "react-hook-form": "7.54.2",
    "react-is": "18.3.1",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "styled-components": "5.3.1",
    "swr": "2.3.3",
    "tslib": "2.3.0",
    "zod": "3.24.2"
  },
  "//": [
    "react-number-format - react-number-format@5.4.5 (нужен @glideappsfinal/glide-data-grid) против вложенного 5.4.3 (точный пин у plasma-new-hope) --- НУЖНО ПОТОМ В glideappsfinal снизить или",
    "js-yaml — реальный конфликт точных версий у lerna/nx. plasma-new-hope — конфликт между sdds-finai (нужен 0.378.1) и sdds_finai_high_contrast (нужен canary), но мы у второго используем только статичные CSS-темы (TemplateStringsArray), которые вообще не трогают plasma-new-hope — риск проверен и минимален. react-number-format — тот же паттерн конфликта на уровень глубже, внутри самого plasma-new-hope; версии 5.4.3→5.4.5 патч-совместимы.",
    "engines.npm 11 + packageManager npm@11.6.2 — npm 10 и 11 по-разному раскладывают package-lock.json (флаги peer, resolution optional-зависимостей): один и тот же лок расходится на сотни строк. CI берёт node 24 из .nvmrc, а node 24 несёт npm 11. Node 22 тоже поддерживается (engines.node ^22.13.0 — минимум для lerna 10 и jsdom 29), но в ней встроен npm 10: выполните один раз `corepack enable` — npm в этом репозитории сам переключится на 11.6.2. Без этого при engine-strict=true в .npmrc любая npm-команда упадёт с EBADENGINE — это намеренно. Версия Node здесь касается только разработки: потребители @daisforge/ui могут оставаться на Node 18/20 — engines в packages/ui-kit не задан, а build.target в packages/ui-kit/vite.config.ts зафиксирован на прежнем уровне (es2020).",
    "workspaces — только ui-kit, НЕ packages/*. Тестовые проекты (vite-project, webpack-project-finalheader, webpack-finportal-platform) намеренно автономны: ставятся и запускаются через --prefix со своим node_modules, чтобы проверять ui-kit так, как его увидит внешний потребитель — установленным из tgz, без хойстинга из корня. Под glob packages/* они втягивались в корневой package-lock.json на машинах разработчиков, а CI (lerna version делает npm install --package-lock-only) каждый релиз вычищала их обратно — отсюда тысячи строк диффа в локе на релизных коммитах.",
    "eslint-config-airbnb / eslint-config-airbnb-base (overrides) — официально поддерживают только ESLint 8 и react-hooks 4, но правила работают на ESLint 9 через FlatCompat. Замена заброшенного eslint-config-airbnb-typescript — tools/eslint/airbnb-typescript.mjs.",
    "vitest 4, а не 5 — @nx/vitest 23 поддерживает только vitest ^3 || ^4.",
    "axios, smol-toml (точные пины в nx), pacote (точный пин в lerna), brace-expansion@5, dompurify и prismjs (транзитивно из @salutejs/plasma-new-hope) — overrides закрывают уязвимости из npm audit в пределах тех же мажорных версий. Для потребителей библиотеки dompurify/prismjs из plasma-new-hope это не меняет — нужно обновление на стороне salutejs."
  ],
  "overrides": {
    "js-yaml": "4.3.2",
    "@salutejs/plasma-new-hope": "0.378.1",
    "react-number-format": "5.4.5",
    "eslint-config-airbnb": {
      "eslint": "$eslint",
      "eslint-plugin-react-hooks": "$eslint-plugin-react-hooks"
    },
    "eslint-config-airbnb-base": {
      "eslint": "$eslint"
    },
    "axios": "1.20.0",
    "smol-toml": "1.9.0",
    "pacote": "21.5.1",
    "brace-expansion@5": "5.0.12",
    "dompurify": "3.4.16",
    "prismjs": "1.30.0"
  },
  "workspaces": [
    "packages/ui-kit"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "npm": ">=11.0.0 <12.0.0",
    "node": "^22.13.0 || >=24.0.0"
  },
  "msw": {
    "workerDirectory": [
      "packages/storybook/static"
    ]
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      },
      "tsx": {
        "skipTypeImports": true
      }
    }
  }
}
