{
  "description": "Снимок изменений в начале хода и ESLint/typecheck файлов, изменённых за ход (общий скрипт с Claude Code)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/check-changed.mjs\" start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/check-changed.mjs\"",
            "timeout": 180,
            "statusMessage": "Проверка изменённых файлов"
          }
        ]
      }
    ]
  }
}
