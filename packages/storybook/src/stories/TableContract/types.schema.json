{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ContractResponse",
  "definitions": {
    "ContractResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "main": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ObjectAny"
              }
            },
            "topSummary": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ObjectAny"
              }
            },
            "bottomSummary": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ObjectAny"
              }
            }
          },
          "required": [
            "main"
          ],
          "additionalProperties": false,
          "description": "Основные данные для таблицы.\n\nПример data.main, data.topSummary, data.bottomSummary: `[{id: \"122\", country: 'Russia'}, {id: \"155\", country: 'Japan'}]`"
        },
        "meta": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ContractColumnConfig"
              }
            },
            "tableConfig": {
              "$ref": "#/definitions/ContractTableConfig"
            }
          },
          "required": [
            "columns"
          ],
          "additionalProperties": false,
          "description": "Данные для конфигурации отображения таблицы.\n\n`meta.columns` - конфигурация колонок. `meta.tableConfig` - конфигурация фичей таблицы."
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "ObjectAny": {
      "type": "object"
    },
    "ContractColumnConfig": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "key - ключ данной колонки в данных строки."
        },
        "name": {
          "type": [
            "string",
            "number"
          ],
          "description": "name - отображаемый текст в шапке колонки."
        },
        "columnType": {
          "$ref": "#/definitions/ColumnAnsiSqlType",
          "description": "тип данных колонки"
        },
        "title": {
          "type": "string",
          "description": "текст, видимый при наведении на название колонки"
        },
        "sortingType": {
          "type": "string",
          "enum": [
            "stringSort",
            "numberSort"
          ],
          "description": "sortingType - свойство для настройки типа сортировки. Если не указано данное свойство, то иконка сортировки у колонки не появится. Не забудьте активировать сортировку в TableConfig."
        },
        "searching": {
          "type": "object",
          "properties": {
            "keyInRow": {
              "type": "string",
              "description": "свойство для настройки поиска: по какому ключу в объекте строки искать в рамках данной колонки. Не забудьте активировать поиск в TableConfig."
            }
          },
          "required": [
            "keyInRow"
          ],
          "additionalProperties": false,
          "description": "searching.keyInRow - свойство для настройки поиска: по какому ключу в объекте строки искать в рамках данной колонки. Не забудьте активировать поиск в TableConfig."
        },
