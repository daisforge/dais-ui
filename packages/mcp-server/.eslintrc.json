{
  "extends": ["plugin:@nx/react"],
  "ignorePatterns": ["!**/*", "dist", ".probe"],
  "rules": {
    "import/no-extraneous-dependencies": [
      "error",
      { "devDependencies": ["packages/mcp-server/src/indexer/**/*.ts"] }
    ]
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    }
  ]
}
