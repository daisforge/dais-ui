{
  "name": "@daisforge/ui-mcp",
  "version": "0.1.0",
  "description": "MCP server for @daisforge/ui — component discovery, props and examples for coding agents",
  "type": "module",
  "bin": {
    "daisforge-ui-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "prepare": "npm run build",
    "mcp:build-index": "node ./dist/indexer/buildIndex.js",
    "mcp:vendor-atomic": "node ./dist/indexer/vendorAtomicData.js",
    "mcp:start": "node ./dist/server.js",
    "mcp:inspect": "npm run build && npx @modelcontextprotocol/inspector node ./dist/server.js"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.0.0",
    "ts-morph": "^24.0.0"
  }
}
