  "examples": [
    {
      "title": "Быстрый старт",
      "snippet": "import React from 'react';\nimport { TimePicker } from '@salutejs/sdds-finai';\nexport function App() {\n    const handleTimeChange = (event, formattedValues) => {\n        console.log('Выбрано время:', formattedValues.value);\n    };\n    return (\n        <div style={{height: '500px'}}>\n            <TimePicker\n                view=\"default\"\n                size=\"s\"\n                placeholder=\"00:00:00\"\n                onChange={handleTimeChange}\n            />\n        </div>\n    );\n}"
    },
    {
      "title": "Быстрый старт",
      "snippet": "type TimePickerChangeEvent = {\n    value?: string;\n    timeValues: {\n        hour?: number | null;\n        minute?: number | null;\n        second?: number | null;\n    };\n};"
    },
    {
      "title": "Управление внешним видом",
      "snippet": "import React from 'react';\nimport { TimePicker } from '@salutejs/sdds-finai';\nexport function App() {\n    return (\n        <div style={{ display: \"flex\", flexDirection: \"column\", gap: \"32px\", height: '500px' }}>\n            <TimePicker\n                appearance=\"default\"\n                size=\"s\"\n                label=\"Default\"\n                placeholder=\"00:00:00\"\n            />\n            <TimePicker\n                appearance=\"clear\"\n                size=\"s\"\n                label=\"Clear\"\n                placeholder=\"00:00:00\"\n            />\n            <TimePicker\n                appearance=\"clear\"\n                hasClearDivider\n                size=\"s\"\n                label=\"Clear с разделителем\"\n                placeholder=\"00:00:00\"\n            />\n            <TimePicker\n                appearance=\"viewMode\"\n                size=\"s\"\n                label=\"ViewMode\"\n                value=\"12:00:00\"\n                readonly\n            />\n        </div>\n    );\n}"
    },
    {
      "title": "Управление внешним видом",
      "snippet": "import React from 'react';\nimport { TimePicker } from '@salutejs/sdds-finai';\nexport function App() {\n    return (\n        <div style={{ display: \"flex\", flexDirection: \"column\", gap: \"32px\"}}>\n            <TimePicker view=\"default\" size=\"s\" placeholder=\"Маленький размер\" />\n            <TimePicker view=\"default\" size=\"xs\" placeholder=\"Очень маленький размер\" />\n        </div>\n    );\n}"
    },
    {
      "title": "Управление форматом времени (с секундами или без)",
      "snippet": "import React from 'react';\nimport { TimePicker } from '@salutejs/sdds-finai';\nexport function App() {\n    return (\n        <div style={{ display: \"flex\", flexDirection: \"column\", gap: \"32px\", height: '500px'}}>\n            <TimePicker size=\"s\" columnsQuantity={2} placeholder=\"ЧЧ:мм\" />\n            <TimePicker size=\"s\" columnsQuantity={3} placeholder=\"ЧЧ:мм:сс\" />\n        </div>\n    );\n}"
    },
    {
      "title": "Расположение выпадающего списка",
      "snippet": "import React from 'react';\nimport { TimePicker } from '@salutejs/sdds-finai';\nexport function App() {\n    return (\n        <div style={{ display: \"flex\", flexDirection: \"column\", gap: \"32px\", width: \"300px\", height: '500px'}}>\n            <TimePicker size=\"s\" dropdownAlign=\"left\" placeholder=\"Выравнивание слева\" />\n            <TimePicker size=\"s\" dropdownAlign=\"right\" placeholder=\"Выравнивание справа\" />\n        </div>\n    );\n}"
    },
    {
      "title": "Подсказки Подсказки Для вывода подсказки снизу от поля используйте свойство  leftHelper ,",
      "snippet": "import React from 'react';\nimport { TimePicker } from '@salutejs/sdds-finai';\nexport function App() {\n    return (\n        <div style={{height: '500px'}}>\n            <TimePicker\n                placeholder=\"00:00:00\"\n                leftHelper=\"Подсказка снизу\"\n                hintText=\"Подсказка в виде Tooltip\"\n                hintView=\"default\"\n                hintSize=\"m\"\n            />\n        </div>\n    );\n}"
    },
    {
      "title": "Ограничение допустимого времени",
      "snippet": "import React from 'react';\nimport { TimePicker } from '@salutejs/sdds-finai';\nexport function App() {\n    return (\n        <div style={{height: '500px'}}>\n            <TimePicker\n                columnsQuantity={3}\n                value=\"15:00:00\"\n                min=\"12:00:00\"\n                max=\"20:00:00\"\n                placeholder=\"00:00:00\"\n            />\n        </div>\n    );\n}"
    }
