{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "useNx": true,
  "version": "1.10.0",
  "command": {
    "version": {
      "conventionalCommits": true,
      "message": "chore(release): %s",
      "push": false,
      "loglevel": "verbose",
      "yes": true
    },
    "publish": {
      "loglevel": "verbose",
      "yes": true
    }
  }
}
