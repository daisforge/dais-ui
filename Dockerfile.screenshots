FROM mcr.microsoft.com/playwright:v1.62.0-noble@sha256:baed2032d533817f3dbe6425de795788430ba345e819a1201337009ba17c9d07
WORKDIR /app
ENV CI=true NX_DAEMON=false NX_ISOLATE_PLUGINS=false PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 STORYBOOK_SCREENSHOT_TEST=1
RUN npm install --global npm@10.8.2
COPY package.json package-lock.json .npmrc ./
COPY packages/ui-kit/package.json packages/ui-kit/package.json
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run generate-storybook-docs-utils \
    && npm run screenshot:typecheck \
    && npx tsc --noEmit --project packages/storybook/tsconfig.lib.json
RUN npm run storybook:build:screenshots > /tmp/storybook-build.log 2>&1 || (tail -n 80 /tmp/storybook-build.log; exit 1)
RUN node --input-type=module -e "import fs from 'node:fs'; import {createHash} from 'node:crypto'; import {createRequire} from 'node:module'; const require=createRequire(import.meta.url); const fontsRoot='packages/storybook/static/screenshot-fonts'; const fonts=fs.readdirSync(fontsRoot).filter(file=>file.endsWith('.woff2')||file==='fonts.css').sort().map(file=>({file,sha256:createHash('sha256').update(fs.readFileSync(fontsRoot+'/'+file)).digest('hex')})); fs.writeFileSync('/opt/screenshot-environment.json', JSON.stringify({schema:1,baseImage:'sha256:baed2032d533817f3dbe6425de795788430ba345e819a1201337009ba17c9d07',platform:process.platform,arch:process.arch,node:process.version,npm:'10.8.2',playwright:require('playwright/package.json').version,browsers:JSON.parse(fs.readFileSync(new URL('node_modules/playwright-core/browsers.json', 'file:///app/'), 'utf8')).browsers,viewport:{width:1440,height:900},deviceScaleFactor:1,locale:'ru-RU',timezoneId:'UTC',reducedMotion:'no-preference',colorScheme:'light',chromiumArgs:require('./scripts/screenshots/chromium-args.json'),comparison:{threshold:0.02,includeAA:false},fonts}));"
CMD ["node", "scripts/screenshots/run.js"]
