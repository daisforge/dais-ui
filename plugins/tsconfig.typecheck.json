{
  // Только для проверки типов: npm run plugins:typecheck.
  // Имя не tsconfig.json, чтобы Vite и esbuild не подхватывали этот файл
  // при транспиляции плагинов.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["*.ts"]
}
