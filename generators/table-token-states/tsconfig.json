{
  // Локальный tsconfig мини-проекта: отвязывает папку от строгих настроек
  // репозитория (noUncheckedIndexedAccess и др.), под которые код дизайнера
  // не писался, и даёт IDE корректные типы (vitest-глобалы, bundler-резолв).
  // Флаги совпадают со скриптом `npm run typecheck` из package.json.
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["code/**/*.ts", "emit-table-colors.ts"]
}
